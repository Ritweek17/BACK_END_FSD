<div class="gsap-reveal group bg-[#0D1B29] rounded-[40px] p-8 border border-white/5 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(249,115,22,0.08)] hover:border-orange-500/20 opacity-0 translate-y-20">
  <div>
    <!-- Image Container with Zoom Effect -->
    <div class="relative w-full h-[200px] sm:h-[240px] rounded-3xl overflow-hidden mb-6">
      <img src="<%= project.image %>" alt="Screenshot of <%= project.title %>" loading="lazy" width="500" height="300" class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-110" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0D1B29] via-transparent to-transparent opacity-60"></div>
    </div>

    <!-- Category -->
    <p class="text-orange-500 text-xs font-semibold tracking-wider uppercase mb-2">
      <%= project.category %>
    </p>

    <!-- Title -->
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4 group-hover:text-orange-500 transition-colors duration-300">
      <%= project.title %>
    </h2>

    <!-- Description -->
    <p class="text-gray-400 text-sm sm:text-base leading-relaxed mb-6">
      <%= project.description %>
    </p>

    <!-- Features List -->
    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-3">Key Features</h3>
    <ul class="space-y-2 mb-6 text-sm text-gray-400">
      <% project.features.forEach(feature => { %>
        <li class="flex items-start gap-2.5">
          <span class="text-orange-500 mt-1.5 h-1.5 w-1.5 rounded-full bg-orange-500 shrink-0"></span>
          <span><%= feature %></span>
        </li>
      <% }) %>
    </ul>

    <!-- Tech Stack Badges -->
    <div class="flex flex-wrap gap-2 mb-8">
      <% project.tech.forEach(skill => { %>
        <div class="bg-[#08121C] border border-[#1F3A52]/50 px-3.5 py-1.5 rounded-xl text-xs font-medium text-gray-300 hover:border-orange-500/40 hover:bg-[#14283B] transition-all duration-300">
          <%= skill %>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex gap-4">
    <a href="<%= project.demo %>" target="_blank" rel="noopener noreferrer" aria-label="Live Demo of <%= project.title %>" class="flex-1 flex items-center justify-center gap-2 bg-orange-500 text-white font-semibold py-3.5 px-4 rounded-2xl hover:bg-orange-600 active:scale-95 transition-all duration-300 shadow-md hover:shadow-orange-500/20">
      <span>Live Demo</span>
      <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
    </a>

    <a href="<%= project.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub Repository for <%= project.title %>" class="flex-1 flex items-center justify-center gap-2 border border-[#1F3A52] text-gray-300 font-semibold py-3.5 px-4 rounded-2xl hover:border-orange-500 hover:bg-[#14283B] hover:text-white active:scale-95 transition-all duration-300">
      <i class="fa-brands fa-github text-lg"></i>
      <span>GitHub</span>
    </a>
  </div>
</div>
