<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="relative min-h-screen overflow-x-hidden text-white bg-gradient-to-b from-[#08121C] via-[#0D1B29] to-[#08121C]">
  
  <!-- Mouse Glow -->
  <div id="mouse-glow" class="pointer-events-none fixed top-0 left-0 w-4 h-4 bg-orange-500 rounded-full mix-blend-screen opacity-50 z-[9999]" style="box-shadow: 0 0 20px 10px rgba(249, 115, 22, 0.5); transform: translate(-50%, -50%); display: none;"></div>

  <!-- Scroll Progress -->
  <div class="fixed top-0 left-0 w-full h-1 bg-white/10 z-[1000]">
    <div id="scroll-progress" class="h-full bg-orange-500 w-0"></div>
  </div>

  <%- include('../partials/navbar') %>

  <main class="relative z-10 pt-20 md:pt-24 lg:pt-28">
    
    <!-- Hero Section -->
    <section id="home" class="max-w-7xl mx-auto px-6 lg:px-8 min-h-screen flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-20">
      <!-- Left Side -->
      <div class="flex-1 text-center lg:text-left">
        <p class="hero-text text-orange-500 text-2xl mb-6">Hello 👋</p>
        <h1 class="hero-text text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight">I'm Ritweek</h1>
        <h2 class="hero-text text-3xl sm:text-4xl lg:text-5xl text-gray-300 mt-5">Full Stack Developer</h2>
        <p class="hero-text text-gray-400 text-lg leading-8 mt-8 max-w-xl mx-auto lg:mx-0">
          Passionate Computer Science student at ABES Engineering College.
          I enjoy building modern web applications and solving problems
          through code. Currently exploring React, Node.js and backend
          development to become a Full Stack Developer.
        </p>
        <!-- Buttons -->
        <div class="hero-text flex flex-wrap justify-center lg:justify-start gap-6 mt-12">
          <a href="/resume.pdf" download class="bg-orange-500 px-8 md:px-10 py-4 rounded-3xl text-lg md:text-xl hover:bg-orange-600 hover:scale-105 transition-all duration-300">Download CV</a>
          <a href="#contact" class="border border-[#1F3A52] px-8 md:px-10 py-4 rounded-3xl text-lg md:text-xl hover:border-orange-500 hover:bg-[#14283B] hover:scale-105 transition-all duration-300">Contact Me</a>
        </div>
      </div>
      <!-- Right Side -->
      <div class="hero-image flex-1 flex justify-center items-center relative mt-20 lg:mt-0 opacity-0 translate-x-20">
        <!-- Orange Glow -->
        <div class="absolute w-[280px] h-[280px] sm:w-[350px] sm:h-[350px] lg:w-[550px] lg:h-[550px] bg-orange-500 rounded-full blur-[180px] opacity-30"></div>
        <!-- Availability Badge -->
        <div class="absolute top-3 left-1/2 -translate-x-1/2 sm:-top-0 sm:left-3/4 lg:top-0 lg:right-0 lg:translate-x-4 lg:left-auto z-20 bg-[#081827] border border-[#1F3A52] px-5 py-3 rounded-3xl shadow-lg">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
            <span class="text-white text-xs md:text-base whitespace-nowrap">Available for opportunities</span>
          </div>
        </div>
        <!-- Avatar -->
        <img id="avatar-img" src="/images/hero.png" alt="Ritweek Dubey" class="relative z-10 mt-16 sm:mt-10 lg:mt-0 w-[250px] sm:w-[320px] lg:w-[600px] object-contain" />
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="max-w-7xl mx-auto px-8 py-32">
      <div class="gsap-reveal bg-[#0D1B29] rounded-[40px] p-12 opacity-0 translate-y-20">
        <p class="text-orange-500 text-sm tracking-widest uppercase">About Me</p>
        <div class="grid md:grid-cols-2 gap-20 mt-10">
          <div>
            <h2 class="text-5xl font-bold mb-8">Who's Ritweek?</h2>
            <p class="text-gray-400 leading-8 text-lg">Computer Science Engineering student passionate about building modern web applications and solving real-world problems through technology.</p>
            <p class="text-gray-400 leading-8 text-lg mt-4">I enjoy creating responsive user interfaces, developing scalable applications, and transforming ideas into functional digital products.</p>
            <p class="text-gray-400 leading-8 text-lg mt-4">Currently focused on Full Stack Development, Data Structures & Algorithms, and building production-level applications using modern web technologies.</p>
          </div>
          <div class="space-y-10">
            <div><h3 class="text-gray-500 mb-2">Education</h3><p class="text-2xl">ABES Engineering College</p></div>
            <div><h3 class="text-gray-500 mb-2">Branch</h3><p class="text-2xl">Computer Science Engineering</p></div>
            <div><h3 class="text-gray-500 mb-2">Location</h3><p class="text-2xl">Ghaziabad, India</p></div>
            <div><h3 class="text-gray-500 mb-2">Status</h3><p class="text-2xl text-green-400">Learning & Building 🚀</p></div>
          </div>
        </div>
        <!-- Stats -->
        <div class="grid md:grid-cols-3 gap-10 mt-24">
          <div class="bg-[#08121C] rounded-3xl p-8 transition-transform hover:scale-105 duration-300">
            <h1 class="text-5xl font-bold text-orange-500">10+</h1><p class="text-gray-400 mt-3">Projects</p>
          </div>
          <div class="bg-[#08121C] rounded-3xl p-8 transition-transform hover:scale-105 duration-300">
            <h1 class="text-5xl font-bold text-orange-500">500+</h1><p class="text-gray-400 mt-3">DSA Problems</p>
          </div>
          <div class="bg-[#08121C] rounded-3xl p-8 transition-transform hover:scale-105 duration-300">
            <h1 class="text-5xl font-bold text-orange-500">15+</h1><p class="text-gray-400 mt-3">Technologies</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Marquee (Simplified from TechMarquee.jsx) -->
    <div class="gsap-reveal overflow-hidden whitespace-nowrap bg-[#0D1B29]/50 py-10 opacity-0 translate-y-20">
      <div class="inline-block animate-marquee text-4xl sm:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-gray-700 via-gray-500 to-gray-700">
        HTML5 • CSS3 • JAVASCRIPT • REACT.JS • NODE.JS • EXPRESS.JS • MONGODB • TAILWIND CSS • C++ • GIT • GITHUB • HTML5 • CSS3 • JAVASCRIPT • REACT.JS • NODE.JS • EXPRESS.JS • MONGODB • TAILWIND CSS • C++ • GIT • GITHUB •
      </div>
    </div>

    <!-- Tech Stack Section -->
    <section id="tech" class="max-w-7xl mx-auto px-8 py-32">
      <p class="text-orange-500 tracking-widest text-sm uppercase">Technologies</p>
      <h1 class="text-4xl md:text-5xl font-bold mt-4 mb-16">My Tech Stack</h1>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% 
          const categories = [
            { title: "Frontend", skills: ["HTML5", "CSS3", "JavaScript", "React.js", "Tailwind CSS", "GSAP"] },
            { title: "Backend", skills: ["Node.js", "Express.js", "MongoDB"] },
            { title: "Programming", skills: ["C++", "JavaScript"] },
            { title: "Tools", skills: ["Git", "GitHub", "Vercel", "Render", "VS Code"] },
            { title: "Deployment", skills: ["Vercel", "Render"] }
          ];
        %>
        <% categories.forEach(cat => { %>
          <div class="gsap-reveal bg-[#0D1B29] rounded-[40px] p-8 border border-white/5 transition-all duration-300 hover:scale-[1.03] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(249,115,22,0.05)] opacity-0 translate-y-20">
            <h2 class="text-2xl font-bold mb-6 text-orange-500"><%= cat.title %></h2>
            <div class="flex flex-wrap gap-3">
              <% cat.skills.forEach(skill => { %>
                <div class="bg-[#08121C] border border-[#1F3A52]/50 px-4 py-2 rounded-xl text-sm font-medium hover:border-orange-500/50 hover:bg-[#14283B] transition-all duration-300">
                  <%= skill %>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="max-w-7xl mx-auto px-6 md:px-8 py-24">
      <p class="text-orange-500 tracking-widest text-sm uppercase">Featured Projects</p>
      <h1 class="text-4xl md:text-5xl font-bold mt-4 mb-16">Things I've Built</h1>
      <div class="grid md:grid-cols-2 gap-10">
        <% projects.forEach(project => { %>
          <%- include('../partials/project-card', { project }) %>
        <% }) %>
      </div>
    </section>

    <!-- Coding Profiles Section -->
    <section id="coding" class="max-w-7xl mx-auto px-6 md:px-8 py-24">
      <p class="text-orange-500 tracking-widest text-sm uppercase">Problem Solving</p>
      <h1 class="text-4xl md:text-5xl font-bold mt-4">Coding Profiles</h1>
      <p class="text-gray-400 mt-4 mb-16 text-lg max-w-2xl">Platforms where I practice problem solving and improve my development skills.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        <% 
          const profilesData = [
            { name: "GitHub", label: "Projects & Contributions", link: "https://github.com/Ritweek17", iconClass: "fa-brands fa-github", colorClass: "group-hover:text-white" },
            { name: "LeetCode", label: "DSA Practice", link: "https://leetcode.com/u/Ritweek_Dubey/", iconClass: "si si-leetcode", colorClass: "group-hover:text-[#FFA116]" },
            { name: "CodeChef", label: "Competitive Programming", link: "https://www.codechef.com/users/ritweek_17", iconClass: "si si-codechef", colorClass: "group-hover:text-[#785F33]" },
            { name: "Codeforces", label: "Competitive Programming", link: "https://codeforces.com/profile/ritweekdubey2006", iconClass: "si si-codeforces", colorClass: "group-hover:text-[#318DFF]" },
            { name: "HackerRank", label: "Skill Certifications", link: "https://www.hackerrank.com/profile/ritweekdubey2006", iconClass: "fa-brands fa-hackerrank", colorClass: "group-hover:text-[#2EC866]" },
            { name: "GeeksforGeeks", label: "DSA Practice", link: "https://www.geeksforgeeks.org/user/ritweek17", iconClass: "si si-geeksforgeeks", colorClass: "group-hover:text-[#2F8D46]" },
            { name: "Codolio", label: "All Coding Profiles", link: "https://lnkd.in/gfWqr8HD", iconClass: "fa-solid fa-code", colorClass: "group-hover:text-orange-500" },
            { name: "AtCoder", label: "Competitive Programming", link: "https://atcoder.jp/users/ritweek_17", iconClass: "fa-solid fa-terminal", colorClass: "group-hover:text-gray-300" },
            { name: "InterviewBit", label: "DSA Practice", link: "https://www.interviewbit.com/profile/ritweek-dubey", iconClass: "fa-solid fa-brain", colorClass: "group-hover:text-[#00A4E4]" }
          ];
        %>
        <% profilesData.forEach((profile, index) => { %>
          <a href="<%= profile.link %>" target="_blank" rel="noopener noreferrer" class="gsap-reveal group bg-[#0D1B29] rounded-[30px] p-6 border border-white/5 flex flex-col justify-between relative overflow-hidden transition-all duration-300 hover:scale-[1.04] hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(249,115,22,0.06)] hover:border-orange-500/20 opacity-0 translate-y-10">
            <div class="flex justify-between items-start">
              <div class="text-4xl text-gray-500 transition-colors duration-300 <%= profile.colorClass %>">
                <i class="<%= profile.iconClass %>"></i>
              </div>
              <i class="fa-solid fa-arrow-up-right-from-square text-gray-500 group-hover:text-orange-500 text-sm opacity-0 group-hover:opacity-100 transition-all duration-300 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
            </div>
            <div class="mt-8">
              <h2 class="text-xl font-bold text-white group-hover:text-orange-500 transition-colors duration-300"><%= profile.name %></h2>
              <p class="text-gray-400 text-xs sm:text-sm mt-1"><%= profile.label %></p>
            </div>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- Certifications Section -->
    <section id="certifications" class="max-w-7xl mx-auto px-8 py-32">
      <p class="text-orange-500 tracking-widest text-sm uppercase">Certifications</p>
      <h1 class="text-4xl md:text-5xl font-bold mt-4 mb-16">Courses & Certifications</h1>
      <div class="grid md:grid-cols-2 gap-10">
        <% 
          const certs = [
            { title: "Legacy JavaScript Algorithms", provider: "freeCodeCamp", image: "/images/fcc_js_cert.png", description: "Completed JavaScript fundamentals, ES6 concepts, algorithms...", skills: ["JavaScript", "Algorithms", "Data Structures", "Problem Solving"], verification: "https://www.freecodecamp.org/certification/ritweek_17/javascript-algorithms-and-data-structures" },
            { title: "Problem Solving (Basic)", provider: "HackerRank", image: "/images/hackerrank_problem_solving_cert.png", description: "Certified in fundamental programming concepts, logical thinking, and algorithmic problem solving.", skills: ["Problem Solving", "Algorithms", "Programming Logic"], verification: "https://www.hackerrank.com/certificates/fc52ceab89e6" },
            { title: "CSS (Basic)", provider: "HackerRank", image: "/images/hackerrank_css_cert.png", description: "Certified understanding of CSS fundamentals, styling techniques, selectors, and responsive web design concepts.", skills: ["CSS", "Web Styling", "Responsive Design"], verification: "https://www.hackerrank.com/certificates/68b35e71f6e0" },
            { title: "500 Difficulty Rating Practice Problems", provider: "CodeChef", image: "/images/codechef_500_cert.png", description: "Completed competitive programming practice problems focused on improving logical thinking and coding consistency.", skills: ["Competitive Programming", "C++", "Problem Solving"], verification: "https://www.codechef.com/certificates/public/a9e6c1b" }
          ];
        %>
        <% certs.forEach(cert => { %>
          <div class="gsap-reveal group bg-[#0D1B29] rounded-[40px] p-8 border border-white/5 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(249,115,22,0.05)] hover:border-orange-500/20 opacity-0 translate-y-16">
            <div>
              <div class="relative w-full h-[180px] sm:h-[220px] rounded-3xl overflow-hidden mb-6 border border-white/5">
                <img src="<%= cert.image %>" alt="Certificate of <%= cert.title %>" loading="lazy" width="400" height="250" class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0D1B29] via-transparent to-transparent opacity-40"></div>
              </div>
              <p class="text-orange-500 text-xs font-semibold tracking-wider uppercase mb-1"><%= cert.provider %></p>
              <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 group-hover:text-orange-500 transition-colors duration-300"><%= cert.title %></h2>
              <p class="text-gray-400 text-sm leading-relaxed mb-6"><%= cert.description %></p>
              <div class="flex flex-wrap gap-2 mb-6">
                <% cert.skills.forEach(skill => { %>
                  <span class="bg-[#08121C] border border-[#1F3A52]/50 px-3 py-1 rounded-xl text-xs font-medium text-gray-300 hover:border-orange-500/40 hover:bg-[#14283B] transition-all duration-300"><%= skill %></span>
                <% }) %>
              </div>
            </div>
            <div class="flex gap-4 mt-4">
              <a href="<%= cert.image %>" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center gap-2 bg-orange-500 text-white font-semibold py-3.5 px-4 rounded-2xl hover:bg-orange-600 active:scale-95 transition-all duration-300 shadow-md hover:shadow-orange-500/20">
                <span>View Certificate</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
              </a>
              <a href="<%= cert.verification %>" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center gap-2 border border-[#1F3A52] text-gray-300 font-semibold py-3.5 px-4 rounded-2xl hover:border-orange-500 hover:bg-[#14283B] hover:text-white active:scale-95 transition-all duration-300">
                <span>Verify</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="max-w-7xl mx-auto px-8 py-32">
      <div class="gsap-reveal bg-[#0D1B29] rounded-[40px] p-12 border border-white/5 relative overflow-hidden opacity-0 translate-y-20">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-orange-500/5 rounded-full blur-[100px]"></div>
        <p class="text-orange-500 tracking-widest text-sm uppercase">Contact</p>
        <h1 class="text-4xl md:text-5xl font-bold mt-4">Let's Work Together</h1>
        <p class="text-gray-400 mt-8 text-lg max-w-2xl leading-8">
          I'm always interested in new opportunities, collaborations, and exciting projects. Feel free to reach out!
        </p>

        <div class="grid md:grid-cols-2 gap-12 mt-12 relative z-10">
          
          <!-- Contact details & form -->
          <div>
            <form id="contact-form" class="space-y-6">
              <div>
                <label for="name" class="block text-gray-500 mb-2 uppercase text-xs font-bold tracking-wider">Name</label>
                <input type="text" id="name" name="name" required class="w-full bg-[#08121C] border border-[#1F3A52]/50 text-white px-4 py-3 rounded-xl focus:outline-none focus:border-orange-500 transition-colors" placeholder="John Doe">
              </div>
              <div>
                <label for="email" class="block text-gray-500 mb-2 uppercase text-xs font-bold tracking-wider">Email</label>
                <input type="email" id="email" name="email" required class="w-full bg-[#08121C] border border-[#1F3A52]/50 text-white px-4 py-3 rounded-xl focus:outline-none focus:border-orange-500 transition-colors" placeholder="john@example.com">
              </div>
              <div>
                <label for="message" class="block text-gray-500 mb-2 uppercase text-xs font-bold tracking-wider">Message</label>
                <textarea id="message" name="message" rows="4" required class="w-full bg-[#08121C] border border-[#1F3A52]/50 text-white px-4 py-3 rounded-xl focus:outline-none focus:border-orange-500 transition-colors" placeholder="Your message here..."></textarea>
              </div>
              <button type="submit" class="inline-flex items-center gap-3 bg-orange-500 text-white font-semibold px-8 py-4 rounded-2xl hover:bg-orange-600 transition-all duration-300 shadow-lg hover:shadow-orange-500/40 hover:scale-105 active:scale-95">
                <i class="fa-solid fa-paper-plane text-xl"></i>
                <span>Send Message</span>
              </button>
              <div id="form-message" class="mt-4 text-sm hidden"></div>
            </form>
          </div>

          <!-- Social connections -->
          <div>
            <div class="space-y-8 mb-12">
              <div>
                <h3 class="text-gray-500 mb-2 uppercase text-xs font-bold tracking-wider">Email</h3>
                <p class="text-xl sm:text-2xl font-semibold hover:text-orange-500 transition-colors duration-300">
                  <a href="mailto:ritweekdubey2006@gmail.com">ritweekdubey2006@gmail.com</a>
                </p>
              </div>
              <div>
                <h3 class="text-gray-500 mb-2 uppercase text-xs font-bold tracking-wider">Location</h3>
                <p class="text-xl sm:text-2xl font-semibold">Ghaziabad, India</p>
              </div>
            </div>

            <h3 class="text-gray-500 mb-4 uppercase text-xs font-bold tracking-wider">Connect With Me</h3>
            <div class="flex flex-wrap gap-4">
              <a href="https://github.com/Ritweek17" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl flex items-center justify-center bg-[#08121C] border border-[#1F3A52]/50 text-2xl text-gray-400 hover:text-orange-500 hover:border-orange-500/50 transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(249,115,22,0.25)]" title="GitHub">
                <i class="fa-brands fa-github"></i>
              </a>
              <a href="https://www.linkedin.com/in/ritweek17/" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl flex items-center justify-center bg-[#08121C] border border-[#1F3A52]/50 text-2xl text-gray-400 hover:text-orange-500 hover:border-orange-500/50 transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(249,115,22,0.25)]" title="LinkedIn">
                <i class="fa-brands fa-linkedin"></i>
              </a>
              <a href="https://lnkd.in/gfWqr8HD" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl flex items-center justify-center bg-[#08121C] border border-[#1F3A52]/50 text-2xl text-gray-400 hover:text-orange-500 hover:border-orange-500/50 transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(249,115,22,0.25)]" title="Coding Profiles">
                <i class="fa-solid fa-code"></i>
              </a>
              <a href="mailto:ritweekdubey2006@gmail.com" class="w-14 h-14 rounded-2xl flex items-center justify-center bg-[#08121C] border border-[#1F3A52]/50 text-2xl text-gray-400 hover:text-orange-500 hover:border-orange-500/50 transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(249,115,22,0.25)]" title="Email">
                <i class="fa-solid fa-envelope"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>

  <!-- Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <!-- <script src="https://unpkg.com/@studio-freight/lenis@1.0.34/dist/lenis.min.js"></script> -->
  <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1/bundled/lenis.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
