{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "build:css": "npx @tailwindcss/cli -i ./src/index.css -o ./public/css/output.css",
    "watch:css": "npx @tailwindcss/cli -i ./src/index.css -o ./public/css/output.css --watch"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.14"
  }
}
